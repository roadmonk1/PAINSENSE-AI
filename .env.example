# PAINSENSE-AI Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# Application Settings
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security (Generate a strong random key in production)
SECRET_KEY=painsense_dev_secret_key_change_in_production_min_32_chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default is local SQLite for instant setup; for PostgreSQL use: postgresql://user:password@localhost:5432/painsense
DATABASE_URL=sqlite:///./painsense.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend API URL (for Vite frontend)
VITE_API_BASE_URL=http://localhost:8000/api

# AI / ML Service Providers (Optional - default uses built-in local heuristic & offline ML models)
SPEECH_PROVIDER=local_whisper
# Cloud API keys (optional, only if using cloud providers)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Emergency & Calling Providers (Optional - default is 'demo')
CALL_PROVIDER=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EMERGENCY_DISPATCH_PHONE=+18005550199

# Demo Mode Settings
ENABLE_DEMO_MODE=True
